#!/usr/bin/env bash
set -u

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
SECRETS_FILE="$HOME/.config/codex-box/secrets.env"
INSTALL_COMPUTER=0
CPTR_PORT=8000

count_skills() {
  local skills_dir=${1:-$HOME/.agents/skills}
  local skill_count=0
  local skill_dir

  for skill_dir in "$skills_dir"/*; do
    if [[ -r "$skill_dir/SKILL.md" ]]; then
      skill_count=$((skill_count + 1))
    fi
  done

  printf '%s\n' "$skill_count"
}

if [[ ${1:-} == --count-skills ]]; then
  count_skills "${2:-$HOME/.agents/skills}"
  exit 0
fi

if [[ -r /etc/default/codex-box ]]; then
  # shellcheck source=/dev/null
  source /etc/default/codex-box
fi
if [[ -f "$SECRETS_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$SECRETS_FILE"
fi

ok=0
warn=0
OS_NAME="nieznany"

if [[ -r /etc/os-release ]]; then
  # shellcheck source=/dev/null
  source /etc/os-release
  OS_NAME=${PRETTY_NAME:-$OS_NAME}
fi

check_command() {
  local command_name=$1
  if command -v "$command_name" >/dev/null 2>&1; then
    printf 'OK    %-12s %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf 'BRAK  %-12s\n' "$command_name"
    warn=$((warn + 1))
  fi
}

echo "Codex Box — diagnostyka"
echo "OS:      $OS_NAME"
echo "Arch:    $(uname -m)"
echo "CPU:     $(nproc)"
echo "RAM:     $(free -h | awk '/^Mem:/ {print $2}')"
echo "Dysk /:  $(df -h / | awk 'NR==2 {print $4 " wolne z " $2}')"
echo "Swap:    $(free -h | awk '/^Swap:/ {print $2}')"
echo

for cmd in git gh codex codex-deepseek box-playbook-sync box-computer mise node tailscale tmux nano vi vim rg fd fzf jq direnv shellcheck age; do
  check_command "$cmd"
done

echo
if gh auth status >/dev/null 2>&1; then
  echo "OK    GitHub auth"
else
  echo "UWAGA GitHub: uruchom box-login"
  warn=$((warn + 1))
fi
if codex login status >/dev/null 2>&1; then
  echo "OK    Codex auth"
else
  echo "UWAGA Codex: uruchom box-login"
  warn=$((warn + 1))
fi
if tailscale status >/dev/null 2>&1; then
  echo "OK    Tailscale"
else
  echo "UWAGA Tailscale: uruchom box-login"
  warn=$((warn + 1))
fi
if [[ -f "$HOME/.codex/deepseek-flash.config.toml" ]]; then
  echo "OK    DeepSeek profile"
else
  echo "UWAGA brak profilu DeepSeek"
  warn=$((warn + 1))
fi
if [[ -n ${DEEPSEEK_API_KEY:-} ]]; then
  echo "OK    DeepSeek API key"
else
  echo "INFO  DeepSeek fallback nieaktywny: uruchom box-login"
fi
if [[ "$INSTALL_COMPUTER" == 1 || -f /etc/systemd/system/codex-box-computer.service ]]; then
  if systemctl is-active --quiet codex-box-computer.service; then
    echo "OK    Computer service"
  else
    echo "UWAGA Computer service nie działa: box-computer status"
    warn=$((warn + 1))
  fi
  if curl -fsS "http://127.0.0.1:$CPTR_PORT/api/health" >/dev/null 2>&1; then
    echo "OK    Computer health"
  else
    echo "UWAGA Computer health nie odpowiada: box-computer status"
    warn=$((warn + 1))
  fi
else
  echo "INFO  Open WebUI Computer wyłączony (INSTALL_COMPUTER=0)"
fi
if [[ -L "$HOME/.codex/AGENTS.md" && -r "$HOME/.codex/AGENTS.md" ]]; then
  echo "OK    Agent Playbook AGENTS.md"
else
  echo "UWAGA Agent Playbook AGENTS.md: uruchom box-playbook-sync"
  warn=$((warn + 1))
fi
skill_count=$(count_skills)
if (( skill_count > 0 )); then
  echo "OK    Agent Playbook skills: $skill_count"
else
  echo "UWAGA brak osobistych skills: uruchom box-playbook-sync"
  warn=$((warn + 1))
fi

echo
if (( warn == 0 )); then
  echo "Wszystko wygląda dobrze."
else
  echo "Ostrzeżenia: $warn"
  ok=1
fi
exit "$ok"
